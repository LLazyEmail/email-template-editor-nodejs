{
  "openapi": "3.1.0",
  "info": {
    "title": "Email template editor API",
    "version": "2.0.0",
    "description": "Stores the template tree and the library of reusable elements, and renders the tree into one HTML email. Errors always have the ErrorResponse shape."
  },
  "servers": [
    {
      "url": "http://localhost:9000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        }
      }
    },
    "/tree": {
      "get": {
        "summary": "Get the whole template tree",
        "responses": {
          "200": {
            "description": "Root nodes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TreeNode"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace the whole template tree",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveTreeBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "Invalid request (VALIDATION_ERROR, INVALID_JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Key already exists (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body too large (PAYLOAD_TOO_LARGE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tree/nodes": {
      "post": {
        "summary": "Add a node under a parent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNodeBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The added node",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreeNode"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_ERROR, INVALID_JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Key already exists (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body too large (PAYLOAD_TOO_LARGE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tree/nodes/{key}": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "description": "Tree node key, URL-encoded",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "patch": {
        "summary": "Change a node's title and/or value",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNodeBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "Invalid request (VALIDATION_ERROR, INVALID_JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a node and its children",
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Not found (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/elements": {
      "get": {
        "summary": "List library elements",
        "responses": {
          "200": {
            "description": "All elements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Element"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a library element",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateElementBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The added element",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Element"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_ERROR, INVALID_JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Key already exists (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body too large (PAYLOAD_TOO_LARGE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/elements/{key}": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "description": "Element key, URL-encoded",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "patch": {
        "summary": "Change an element's title and/or value",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateElementBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "Invalid request (VALIDATION_ERROR, INVALID_JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an element",
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Not found (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate": {
      "post": {
        "summary": "Render the tree into an HTML file and return its URL",
        "responses": {
          "200": {
            "description": "Link to the generated file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Template tree is empty (TREE_EMPTY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TreeNode": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "value": {
            "default": "",
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            }
          }
        },
        "required": [
          "key",
          "title"
        ]
      },
      "Element": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "value"
        ]
      },
      "SaveTreeBody": {
        "type": "object",
        "properties": {
          "treeData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            }
          }
        },
        "required": [
          "treeData"
        ]
      },
      "AddNodeBody": {
        "type": "object",
        "properties": {
          "parentKey": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "$ref": "#/components/schemas/TreeNode"
          }
        },
        "required": [
          "parentKey",
          "item"
        ]
      },
      "UpdateNodeBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "CreateElementBody": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "value": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "key",
          "title"
        ]
      },
      "UpdateElementBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "GenerateResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Absolute URL of the generated HTML file"
          }
        },
        "required": [
          "url"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable code, e.g. VALIDATION_ERROR, NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "description": "Validation issues for VALIDATION_ERROR"
              },
              "requestId": {
                "description": "Same as the X-Request-Id response header",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
