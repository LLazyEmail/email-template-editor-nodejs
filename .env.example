# HTTP port the API listens on
PORT=9000
# Path to the JSON storage file
DB_FILE=./db.json
# Directory served as static files (generated templates are written to <PUBLIC_DIR>/generated)
PUBLIC_DIR=./public
# Allowed CORS origin(s), comma separated, or * for any
CORS_ORIGIN=*
# Max JSON request body size
BODY_LIMIT=50mb
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
NODE_ENV=development
